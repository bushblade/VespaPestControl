---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { images } from '../data/images'

interface Props {
  service: CollectionEntry<'services'>
}
const { service } = Astro.props
const { title, imageKey, imageAlt, excerpt, body } = service.data
const img = images[imageKey as keyof typeof images]
const summary = excerpt ?? body[0]
---

<a href="/contactus" class="group flex flex-col overflow-hidden rounded-2xl border border-charcoal-100 bg-white shadow-sm transition-shadow hover:shadow-lg">
  <div class="relative aspect-4/3 overflow-hidden bg-charcoal-100">
    <Image
      src={img}
      alt={imageAlt}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
      widths={[640, 960]}
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-lg font-semibold text-charcoal-950">{title}</h3>
    <p class="mt-2 line-clamp-4 flex-1 text-sm leading-relaxed text-charcoal-600">
      {summary}
    </p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 group-hover:text-brand-800">
      Enquire about this service
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </span>
  </div>
</a>
