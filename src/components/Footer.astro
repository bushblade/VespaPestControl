---
import { openingHours, site } from '../data/site'
import FacebookIcon from './FacebookIcon.astro'
import InstagramIcon from './InstagramIcon.astro'
import WhatsAppIcon from './WhatsAppIcon.astro'
import YouTubeIcon from './YouTubeIcon.astro'

const eradication = [
  'Wasps',
  'Rats',
  'Mice',
  'Ants',
  'Fleas',
  'Bed Bugs',
  'Cockroaches',
  'Flies',
  'Silverfish',
  'Woodlice',
  'SPIs',
  'Spiders',
]
const proofing = ['Rats', 'Mice', 'Squirrels', 'Pigeons']
---

<footer class="bg-charcoal-950 text-charcoal-200">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-semibold text-white">Vespa Pest Control Ltd</p>
      <p class="mt-3 text-sm leading-relaxed">
        We provide Pest Control and Decontamination services in Halifax (UK) and the surrounding
        areas.
      </p>
      <a
        href="/area-coverage"
        class="mt-4 inline-block text-sm font-semibold text-wasp-400 hover:text-wasp-300"
      >
        Click this link to see if we cover your area
      </a>
      <div class="mt-5 flex gap-3">
        <a
          href={site.socials.instagram}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Vespa on Instagram"
        >
          <InstagramIcon class="h-5 w-5" />
        </a>
        <a
          href={site.socials.facebook}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Vespa on Facebook"
        >
          <FacebookIcon class="h-5 w-5" />
        </a>
        <a
          href={site.socials.youtube}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Vespa on YouTube"
        >
          <YouTubeIcon class="h-5 w-5" />
        </a>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Message Vespa on WhatsApp"
        >
          <WhatsAppIcon class="h-5 w-5" />
        </a>
      </div>
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">
        Eradication of
      </p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        {eradication.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="mt-5 font-display text-sm font-semibold uppercase tracking-wider text-white">
        Proofing works
      </p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        {proofing.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">
        Decontamination
      </p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>Viral</li>
        <li>Bacterial</li>
      </ul>
      <p class="mt-5 font-display text-sm font-semibold uppercase tracking-wider text-white">
        Opening Hours
      </p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>{openingHours.week}</li>
        <li>{openingHours.weekend}</li>
        <li>{openingHours.note}</li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">Contact</p>
      <address class="mt-3 space-y-1 text-sm not-italic">
        <p>Vespa Pest Control Ltd</p>
        <p>{site.address.line1}</p>
        <p>{site.address.line2}</p>
        <p>{site.address.city}</p>
        <p>{site.address.postcode}</p>
      </address>
      <div class="mt-4 flex flex-col items-start text-sm">
        <a
          href={site.phoneHref}
          class="inline-block py-1 font-semibold text-wasp-400 hover:text-wasp-300"
        >
          {site.phone}
        </a>
        <a
          href={`mailto:${site.email}?subject=Enquiry`}
          class="inline-block break-all py-1 text-charcoal-200 hover:text-white"
        >
          {site.email}
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-charcoal-900">
    <div class="container-page flex flex-col items-start justify-between gap-4 py-6 text-sm text-charcoal-400 md:flex-row md:items-center">
      <p>
        Featured on{' '}
        <a
          href={site.featuredOn}
          target="_blank"
          rel="noopener"
          class="text-charcoal-200 underline decoration-charcoal-500 underline-offset-2 hover:text-white"
        >
          pestcontrolhalifax.co.uk
        </a>
      </p>
      <p>
        If you love Bees as much as us, check out our favourite wildlife blogger:{' '}
        <a
          href={site.wildlifeBlog}
          target="_blank"
          rel="noopener"
          class="text-charcoal-200 underline decoration-charcoal-500 underline-offset-2 hover:text-white"
        >
          Herbivore Tales
        </a>
      </p>
    </div>
  </div>
</footer>