---
import { openingHours, site } from '../data/site'
import WhatsAppIcon from './WhatsAppIcon.astro'

const eradication = [
  'Wasps',
  'Rats',
  'Mice',
  'Ants',
  'Fleas',
  'Bed Bugs',
  'Cockroaches',
  'Flies',
  'Silverfish',
  'Woodlice',
  'SPIs',
  'Spiders',
]
const proofing = ['Rats', 'Mice', 'Squirrels', 'Pigeons']
---

<footer class="bg-charcoal-950 text-charcoal-200">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-semibold text-white">Vespa Pest Control Ltd</p>
      <p class="mt-3 text-sm leading-relaxed">
        We provide Pest Control and Decontamination services in Halifax (UK) and the surrounding
        areas.
      </p>
      <a
        href="/area-coverage"
        class="mt-4 inline-block text-sm font-semibold text-wasp-400 hover:text-wasp-300"
      >
        Click this link to see if we cover your area
      </a>
      <div class="mt-5 flex gap-3">
        <a
          href={site.socials.instagram}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Vespa on Instagram"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.9.3 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.3-2.3-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.3-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.3-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.3-.4 1.3-.1 1.7-.1 4.9-.1Zm0 2.3c-3.1 0-3.5 0-4.8.1-1.1.1-1.5.2-1.9.3-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.1.4-.2.8-.3 1.9-.1 1.3-.1 1.7-.1 4.8s0 3.5.1 4.8c.1 1.1.2 1.5.3 1.9.2.5.4.8.7 1.1.3.3.6.5 1.1.7.4.1.8.2 1.9.3 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c1.1-.1 1.5-.2 1.9-.3.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.1-.4.2-.8.3-1.9.1-1.3.1-1.7.1-4.8s0-3.5-.1-4.8c-.1-1.1-.2-1.5-.3-1.9-.2-.5-.4-.8-.7-1.1-.3-.3-.6-.5-1.1-.7-.4-.1-.8-.2-1.9-.3-1.3-.1-1.7-.1-4.8-.1Zm0 3.9a4.6 4.6 0 1 1 0 9.2 4.6 4.6 0 0 1 0-9.2Zm0 7.6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6.1-7.8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0Z" />
          </svg>
        </a>
        <a
          href={site.socials.facebook}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Vespa on Facebook"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.57v1.88h2.78l-.45 2.9h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
          </svg>
        </a>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="rounded-md p-2 text-charcoal-300 hover:bg-charcoal-900 hover:text-white"
          aria-label="Message Vespa on WhatsApp"
        >
          <WhatsAppIcon class="h-5 w-5" />
        </a>
      </div>
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">
        Eradication of
      </p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        {eradication.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="mt-5 font-display text-sm font-semibold uppercase tracking-wider text-white">
        Proofing works
      </p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        {proofing.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">
        Decontamination
      </p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>Viral</li>
        <li>Bacterial</li>
      </ul>
      <p class="mt-5 font-display text-sm font-semibold uppercase tracking-wider text-white">
        Opening Hours
      </p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>{openingHours.week}</li>
        <li>{openingHours.weekend}</li>
        <li>{openingHours.note}</li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">Contact</p>
      <address class="mt-3 space-y-1 text-sm not-italic">
        <p>Vespa Pest Control Ltd</p>
        <p>{site.address.line1}</p>
        <p>{site.address.line2}</p>
        <p>{site.address.city}</p>
        <p>{site.address.postcode}</p>
      </address>
      <div class="mt-4 space-y-1.5 text-sm">
        <a href={site.phoneHref} class="font-semibold text-wasp-400 hover:text-wasp-300">
          {site.phone}
        </a>
        <br />
        <a
          href={`mailto:${site.email}?subject=Enquiry`}
          class="break-all text-charcoal-200 hover:text-white"
        >
          {site.email}
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-charcoal-900">
    <div class="container-page flex flex-col items-start justify-between gap-4 py-6 text-sm text-charcoal-400 md:flex-row md:items-center">
      <p>
        Featured on{' '}
        <a
          href={site.featuredOn}
          target="_blank"
          rel="noopener"
          class="text-charcoal-200 hover:text-white"
        >
          pestcontrolhalifax.co.uk
        </a>
      </p>
      <p>
        If you love Bees as much as us, check out our favourite wildlife blogger:{' '}
        <a
          href={site.wildlifeBlog}
          target="_blank"
          rel="noopener"
          class="text-charcoal-200 hover:text-white"
        >
          Herbivore Tales
        </a>
      </p>
    </div>
  </div>
</footer>