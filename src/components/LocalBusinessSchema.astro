---
import { site } from '../data/site'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'PestControlService',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  telephone: site.phoneIntl,
  email: site.email,
  image: `${site.url}/og-image.png`,
  priceRange: '££',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    addressRegion: site.address.county,
    postalCode: site.address.postcode,
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Calderdale' },
    { '@type': 'AdministrativeArea', name: 'Kirklees' },
    { '@type': 'City', name: 'Halifax' },
    { '@type': 'City', name: 'Huddersfield' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '07:00',
      closes: '17:00',
    },
  ],
  sameAs: [site.socials.instagram, site.socials.facebook],
  slogan: 'Wasp nest removal specialists. Rats, Mice and Insects.',
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />