---
import { site } from '../../data/site'
import Layout from '../../layouts/Layout.astro'
---

<Layout
  title="Enquiry Received | Vespa Pest Control Ltd"
  description="Thanks for your enquiry. Vespa Pest Control Ltd will get back to you shortly."
  noindex
>
  <section class="container-page flex flex-col items-center py-24 text-center">
    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-brand-100 text-brand-700">
      <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
    </div>
    <h1 class="mt-6 font-display text-3xl font-bold text-charcoal-950 sm:text-4xl">
      Thanks for your enquiry
    </h1>
    <p class="mt-3 max-w-md text-charcoal-600">
      We've received your message and will get back to you as soon as we can. If your issue is
      urgent, please call us directly.
    </p>
    <a href={site.phoneHref} class="btn btn-accent mt-8">
      Call {site.phone}
    </a>
    <a href="/" class="btn btn-outline mt-3">Back to home</a>
  </section>
</Layout>