---
import { getCollection } from 'astro:content'
import GalleryCard from '../components/GalleryCard.astro'
import VideoCard from '../components/VideoCard.astro'
import Layout from '../layouts/Layout.astro'

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order)
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order)
---

<Layout
  title="Gallery | Vespa Pest Control Ltd Halifax"
  description="Watch wasp nest removal videos and see the rats, mice and bed bug evidence we find around Halifax, West Yorkshire."
>
  <section class="bg-charcoal-950 text-white">
    <div class="container-page py-14 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-wasp-400">Our Gallery</p>
      <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">What We Encounter</h1>
      <p class="mt-3 max-w-2xl text-charcoal-300">
        Here are some of the things we've encountered this year, more to follow.
      </p>
    </div>
  </section>

  <section class="container-page py-14 lg:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-charcoal-950">Videos</h2>
      <p class="mt-3 text-charcoal-600">
        Short clips from recent jobs around Halifax and the surrounding areas.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {videos.map((item) => <VideoCard item={item} />)}
    </div>
  </section>

  <section class="bg-charcoal-50">
    <div class="container-page py-14 lg:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold text-charcoal-950">Images</h2>
        <p class="mt-3 text-charcoal-600">
          A closer look at the nests, infestations and evidence we come across.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {photos.map((item) => <GalleryCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>
