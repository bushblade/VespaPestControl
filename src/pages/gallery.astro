---
import { getCollection } from 'astro:content'
import GalleryCard from '../components/GalleryCard.astro'
import Layout from '../layouts/Layout.astro'

const items = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order)
---

<Layout
  title="Gallery | Vespa Pest Control Ltd Halifax"
  description="See wasp nest removal, rat and mouse infestations, and more from our work around Halifax, West Yorkshire."
>
  <section class="bg-charcoal-950 text-white">
    <div class="container-page py-14 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-wasp-400">Our Gallery</p>
      <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">What We Encounter</h1>
      <p class="mt-3 max-w-2xl text-charcoal-300">
        Here are some of the things we've encountered this year, more to follow.
      </p>
    </div>
  </section>

  <section class="container-page py-14 lg:py-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => <GalleryCard item={item} />)}
    </div>
  </section>
</Layout>