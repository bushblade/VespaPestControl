---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Areas We Cover | Pest Control Halifax & Huddersfield - Vespa Pest Control Ltd"
  description="Vespa Pest Control Ltd covers Calderdale and Kirklees including Halifax, Huddersfield, Brighouse, Hebden Bridge, Sowerby Bridge and more."
>
  <section class="bg-charcoal-950 text-white">
    <div class="container-page py-14 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-wasp-400">Areas We Cover</p>
      <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">Key Areas We Cover</h1>
      <p class="mt-3 max-w-2xl text-charcoal-300">
        We provide Pest Control and Decontamination services in Halifax (UK) and the surrounding
        areas. Click the link to see if we cover your area.
      </p>
    </div>
  </section>

  <section class="container-page py-14 lg:py-20">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {(await getCollection('areas')).map(({ data }) => (
        <div class="rounded-2xl border border-charcoal-100 bg-white p-6 shadow-sm">
          <h2 class="border-b border-charcoal-100 pb-3 font-display text-xl font-semibold text-brand-800">
            {data.group}
          </h2>
          <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-charcoal-700">
            {data.towns.map((town) => <li>{town}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-brand-900 p-8 text-center sm:p-10">
      <h2 class="font-display text-2xl font-semibold text-white">Not sure if we cover you?</h2>
      <p class="mx-auto mt-2 max-w-xl text-brand-100">
        Call us on {`07869 071264`} and we'll let you know right away.
      </p>
      <a href="/contactus" class="btn btn-accent mt-6">Contact us today</a>
    </div>
  </section>
</Layout>