---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import ServiceCard from '../components/ServiceCard.astro'
import { images } from '../data/images'
import { site } from '../data/site'
import Layout from '../layouts/Layout.astro'

const services = (await getCollection('services')).sort((a, b) => a.id.localeCompare(b.id))

const badges = ['Qualified', 'Licenced & Fully Insured', 'Family Run']
---

<Layout
  title="Pest Control Halifax | Wasp Nest Removal Specialists - Vespa Pest Control Ltd"
  description="Vespa Pest Control Ltd provides pest control and decontamination in Halifax, West Yorkshire. Wasp nest removal, rats, mice, bees, insects and commercial contracts. Qualified, licenced and fully insured."
>
  <section class="relative overflow-hidden bg-charcoal-950 text-white">
    <div class="absolute inset-0 bg-linear-to-br from-brand-900 via-charcoal-950 to-charcoal-950" aria-hidden="true" />
    <div class="container-page relative grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-brand-900/40 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-200">
          Serving Calderdale &amp; Surrounding Areas
        </p>
        <h1 class="mt-5 font-display text-4xl font-bold leading-tight sm:text-5xl">
          Wasp Nest Removal
          <span class="block text-wasp-400">Specialists</span>
        </h1>
        <p class="mt-4 text-lg font-medium text-charcoal-100">Rats, Mice and Insects</p>
        <p class="mt-3 max-w-xl text-charcoal-300">
          A local, family run pest control and decontamination company covering Halifax, West
          Yorkshire and the surrounding areas.
        </p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {badges.map((badge) => (
            <li class="rounded-full border border-charcoal-700 bg-charcoal-900/60 px-3 py-1 text-xs font-medium text-charcoal-200">
              {badge}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={site.phoneHref} class="btn btn-accent text-base">
            Call {site.phone}
          </a>
          <a href="/about" class="btn btn-outline border-white/30 text-white hover:border-wasp-400 hover:text-wasp-300">
            Want to know more about us?
          </a>
        </div>

        <a
          href={site.maps}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-brand-200 hover:text-wasp-300"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          Find Vespa Solutions on Google Maps
        </a>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <Image
          src={images.wasps}
          alt="Wasp nest removal specialists in Halifax"
          class="mx-auto w-full rounded-2xl object-cover shadow-2xl ring-1 ring-white/10"
          widths={[480, 640, 960]}
        />
      </div>
    </div>
  </section>

  <section class="container-page py-16 lg:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-charcoal-950">Our Services</h2>
      <p class="mt-3 text-charcoal-600">
        Pest control for homes and businesses in Halifax, Huddersfield and across Calderdale and
        Kirklees. Every enquiry starts with a call for a no obligation quote.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>

    <div class="mt-12 rounded-2xl bg-brand-900 p-8 text-center sm:p-10">
      <h3 class="font-display text-2xl font-semibold text-white">
        Not sure what you've found?
      </h3>
      <p class="mx-auto mt-2 max-w-xl text-brand-100">
        Call us today for a no obligation quote and we'll talk you through the treatment process
        step by step.
      </p>
      <a href={site.phoneHref} class="btn btn-accent mt-6">
        Call {site.phone}
      </a>
    </div>
  </section>
</Layout>